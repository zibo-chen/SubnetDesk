// Native LAN desktop, matching Flutter's sidebar and device cards.
include "icons.tis";
view.windowMinSize = (scaleIt(900), scaleIt(620));
var app;
const navIcons={lan:"devices",recent:"history",favorite:"star",settings:"settings"};
const pageTitles = {lan:"Discovered", recent:"Recent Sessions", favorite:"Favorites", settings:"Settings"};
function readJson(value) { return JSON.parse(value || "[]"); }
function endpoint(address, port) { return (address.indexOf(":") >= 0 ? "["+address+"]" : address)+":"+port; }
function field(name,title,value="",password=false) {
    return <label .field><span>{translate(title)}</span>{password ? <input|password name={name} value={value} /> : <input|text name={name} value={value} />}</label>;
}
class App: Reactor.Component {
    this var page = "lan";
    this var peers = [];
    this var info = {};
    this var favorites = [];
    this var search = "";
    this var reverse = false;
    this var list = false;
    this var dialog = null;
    this var error = "";
    this var showAddresses = false;
    function this() { app = this; }
    function refresh() {
        try {
            this.info = readJson(handler.get_lan_server_info());
            this.favorites = handler.get_fav();
            var discovered = readJson(handler.get_lan_peers());
            var recent = readJson(handler.get_recent_sessions());
            var all = this.page == "lan" ? discovered : recent;
            if (this.page == "favorite") {
                for (var peer in discovered) {
                    var found = false;
                    for (var previous in recent) if (previous.id == peer.id) found = true;
                    if (!found) recent.push(peer);
                }
                var favorites = this.favorites;
                all = recent.filter(function(p) { return favorites.indexOf(p.id) >= 0; });
            }
            this.peers = all.map(function(peer) { peer.alias=handler.get_peer_option(peer.id,"alias") || peer.alias; return peer; });
            this.error = "";
        } catch(e) { this.error = e.toString(); }
        this.update();
    }
    function openDialog(title,content,save) {
        this.dialog={title:title,content:content,save:save}; this.update();
        var me=this;
        self.timer(1ms,function() { view.focus=me.$(.lan-dialog input) || me.$(#close-dialog); });
    }
    function openLanSettings() {
        var info=this.info;
        this.openDialog("LAN · Settings", <div>
            <p .muted>{translate("Your Desktop")} · {translate("Current address")}</p>
            <div .field-row>{field("username","Username",info.username || "")}{field("password","Password","",true)}</div>
            <p .hint>{translate("A password is required when creating or renaming the LAN account")}</p>
            <div .field-row>{field("listen_addresses","Current address",info.listen_addresses || "")}{field("port","Port",(info.port || 21118).toString())}</div>
            {field("allowed_networks","Network",info.allowed_networks || "")}
            <p .hint>{translate("IP Whitelisting")} · CIDR · {translate("Default")}: LAN / VPN</p>
            <div .setting-switch><button|checkbox name="discovery_enabled" {info.discovery_enabled ? {checked:true} : {}}>{translate("Enable LAN discovery")}</button></div>
            <button .text-button #web-toggle>{translate("Web access")} ▾</button><div #web-options style="display:none">
                <button|checkbox name="web_access_enabled" {info.web_access_enabled ? {checked:true} : {}}>{translate("Enable web access")}</button>
                {field("web_listen_port","Port",(info.web_listen_port || 18123).toString())}
                {field("web_certificate_path","Certificate",info.web_certificate_path || "")}
                {field("web_private_key_path","Private key",info.web_private_key_path || "")}
            </div>
            <div .fingerprint><span .muted>{translate("Fingerprint")}</span><p>{info.fingerprint || ""}</p></div>
        </div>,function(values) {
            var error=handler.apply_lan_settings(JSON.stringify(values));
            values.password="";
            return error;
        });
    }
    function connect(id,type="") {
        var error=handler.connect_lan(id,type);
        if(error) { this.error=error; this.update(); }
    }
    function showAdd() {
        this.openDialog("Add",<div>{field("endpoint","Current address",handler.get_remote_id())}<p .hint>LAN / VPN · IPv4 / IPv6 · {translate("Port")}: 21118</p></div>,function(values) {
            var error=handler.connect_lan(values.endpoint || "","");
            if(!error) handler.set_remote_id(values.endpoint);
            return error;
        });
    }
    function peerCard(peer) {
        var id=peer.id;
        var favorite=this.favorites.indexOf(id)>=0;
        var status=peer.online === true ? "online" : peer.online === false ? "offline" : "unknown";
        return <article .peer-card key={id}>
            <div .platform-banner><div .platform-icon>{platformSvg(peer.platform,"#ffffff")}</div></div>
            <div .peer-meta><span class={"presence "+status}/> LAN<button .icon-button .favorite checked={favorite} title={translate("Favorites")} data-id={id} data-action="favorite">{lanIcon(favorite ? "star-filled" : "star",favorite ? "favorite" : "normal")}</button></div>
            <h3>{peer.alias || peer.hostname || id}</h3>
            <div .peer-detail>{lanIcon("person")}<span>{peer.username || "-"}</span></div>
            <div .peer-detail>{lanIcon("desktop")}<span>{peer.hostname || "-"}</span></div>
            <div .peer-detail .peer-address>{lanIcon("network")}<span>{id}</span></div>
            <div .peer-actions><button .connect data-id={id} data-action="connect"><span>{translate("Connect")}</span></button><button .icon-button data-id={id} data-action="more">{lanIcon("more")}</button></div>
        </article>;
    }
    function hostCard() {
        var info=this.info, ready=info.configured && info.running;
        var addresses=info.addresses || [];
        var visible=this.showAddresses ? addresses : addresses.slice(0,1);
        return <div .host-card>
            <div .host-heading>{lanIcon("desktop")}<strong>{translate("Your Desktop")}</strong><span class={"status "+(ready ? "ready" : "warning")}>{translate(ready ? "Ready" : info.configured ? "Service is not running" : "Password Required")}</span><button .icon-button #lan-settings>{lanIcon("tune")}</button></div>
            <div .host-row>{lanIcon("desktop")}<div><small>{translate("Name")}</small><strong>{info.device_name || "SubnetDesk"}</strong></div><button .icon-button #rename>{lanIcon("edit")}</button></div>
            <div .host-row>{lanIcon("person")}<div><small>{translate("Username")}</small><strong>{info.username || "-"}</strong></div></div>
            <div .host-row>{lanIcon("network")}<div><small>{translate("Current address")}</small>{visible.map(function(address) { return <p>{endpoint(address,info.port || 21118)}</p>; })}</div>{addresses.length>1 ? <button .text-button #addresses>{this.showAddresses ? translate("Hide") : "+"+(addresses.length-1)}</button> : ""}</div>
            {!info.configured ? <button .primary #configure><span>{translate("Set Password")}</span></button> : ""}
            {info.runtime_error ? <p .error>{info.runtime_error}</p> : ""}
            {is_win && !handler.is_installed() ? <div .host-actions><button .text-button #install>{translate("Install")}</button><button .text-button #activate>{translate("Start service")}</button></div> : ""}
        </div>;
    }
    function settingsPage() {
        var options=[["enable-keyboard","Enable keyboard/mouse"],["enable-clipboard","Enable clipboard"],["enable-file-transfer","Enable file transfer"],["enable-audio","Enable audio"],["enable-remote-restart","Enable remote restart"]];
        return <section .settings-page>
            <div .settings-card><h3>LAN · {translate("Settings")}</h3><p .muted>{translate("Your Desktop")} · LAN / VPN</p><button .primary #lan-settings><span>{translate("Settings")}</span></button></div>
            <div .settings-card><h3>{translate("General")}</h3><button|checkbox #dark-theme {handler.get_local_option("theme")=="dark" ? {checked:true} : {}}>{translate("Dark Theme")}</button>
                <label .field><span>{translate("Language")}</span><select #language>{readJson(handler.get_langs()).map(function(lang) { return <option value={lang[0]} {handler.get_option("lang")==lang[0] ? {selected:true} : {}}>{lang[1]}</option>; })}</select></label>
            </div>
            <div .settings-card><h3>{translate("Permissions")}</h3>{options.map(function(option) { return <button|checkbox .permission-option data-option={option[0]} {handler.get_option(option[0])!="N" ? {checked:true} : {}}>{translate(option[1])}</button>; })}</div>
            <div .settings-card><h3>{translate("LAN identities")}</h3><button .primary #identities><span>{translate("Manage")}</span></button></div>
            <div .settings-card><h3>SubnetDesk</h3><p>{handler.get_version()}</p><button .text-button #help>{translate("Help")}</button><p .muted>This Application uses Sciter Engine (http://sciter.com), copyright Terra Informatica Software, Inc.</p><button .text-button #sciter-about>sciter.com</button></div>
        </section>;
    }
    function showIdentities() {
        var identities=readJson(handler.lan_identity_action(JSON.stringify({action:"list"}))).identities || [];
        this.openDialog("LAN identities",<div>
            {identities.map(function(identity) { return <div .identity-row><strong>{identity.name}</strong><span .muted>{identity.username}</span><button .text-button data-identity={identity.id} data-action="edit">{translate("Edit")}</button><button .text-button data-identity={identity.id} data-action="default">{translate(identity.is_default ? "Default" : "Set as default")}</button><button .text-button data-identity={identity.id} data-action="delete">{translate("Delete")}</button></div>; })}
            <h3>{translate("Add")}</h3>{field("name","Name")}{field("username","Username")}{field("password","Password","",true)}<button|checkbox name="make_default">{translate("Set as default")}</button>
        </div>,function(values) { values.action="create"; var result=readJson(handler.lan_identity_action(JSON.stringify(values))); values.password=""; return result.error || ""; });
    }
    function renderDialog() {
        if(!this.dialog) return "";
        return <div .dialog-backdrop><div .lan-dialog>
            <div .dialog-heading>{lanIcon("network")}<h2>{translate(this.dialog.title)}</h2><button .icon-button #close-dialog>{lanIcon("close")}</button></div>
            <p .error #dialog-error /><div .dialog-body>{this.dialog.content}</div>
            <div .dialog-footer><button .text-button #cancel-dialog>{translate("Cancel")}</button><button .primary #save-dialog>{lanIcon("check","white")}<span>{translate("Save")}</span></button></div>
        </div></div>;
    }
    function render() {
        var me=this, query=this.search.toLowerCase();
        var peers=this.peers.filter(function(peer) { return !query || [peer.hostname || "",peer.alias || "",peer.username || "",peer.id].join(" ").toLowerCase().indexOf(query)>=0; });
        peers.sort(function(a,b) { var x=(a.alias || a.hostname || a.id).toLowerCase(), y=(b.alias || b.hostname || b.id).toLowerCase(); return (x<y ? -1 : x>y ? 1 : 0)*(me.reverse ? -1 : 1); });
        return <div .lan-app>
            <aside .sidebar><div .brand><img src={handler.get_icon()}/><div><strong>SubnetDesk</strong><small>LAN · {translate(pageTitles[this.page])}</small></div></div>
                <nav>{["lan","recent","favorite","settings"].map(function(page) { return <button class={"nav-item "+(me.page==page ? "selected" : "")} data-page={page}>{lanIcon(navIcons[page],me.page==page ? "accent" : "normal")}<span>{translate(pageTitles[page])}</span></button>; })}</nav>
                {this.hostCard()}<footer><button .text-button #help>{lanIcon("help")}{translate("Help")}</button><span>v{handler.get_version()}</span></footer>
            </aside>
            <main><div .topbar><button .primary #add>{lanIcon("add","white")}<span>{translate("Add")}</span></button><div .search>{lanIcon("search")}<input|text #search value={this.search} novalue={translate("Search")+" · "+translate("Current address")}/></div><button .icon-button #refresh title={translate("Refresh")}>{lanIcon("refresh")}</button><button .icon-button #sort title={translate("Sort")}>{lanIcon("sort")}</button><div .view-toggle><button .icon-button #grid checked={!this.list}>{lanIcon("grid",!this.list ? "accent" : "normal")}</button><button .icon-button #list checked={this.list}>{lanIcon("list",this.list ? "accent" : "normal")}</button></div></div>
                <div .content><h2>{translate(pageTitles[this.page])}{this.page!="settings" ? <small> ({peers.length})</small> : ""}</h2><p .error>{this.error}</p>
                    {this.page=="settings" ? this.settingsPage() : peers.length ? <div class={"peer-grid "+(this.list ? "list-view" : "")}>{peers.map(function(peer) { return me.peerCard(peer); })}</div> : <div .empty-state>{lanIcon("devices")}<h3>{translate("No devices found")}</h3><p .muted>LAN / VPN · {translate("Current address")}</p><button .primary #add><span>{translate("Add")}</span></button></div>}
                </div></main>{this.renderDialog()}
        </div>;
    }
    event click $(button[data-page]) (_,button) { this.page=button.attributes["data-page"]; this.search=""; this.refresh(); }
    event change $(input#search) (_,input) { this.search=input.value || ""; this.update(); }
    event click $(#lan-settings, #configure) { this.openLanSettings(); }
    event click $(#web-toggle) { var options=this.$(#web-options); options.style["display"]=options.style["display"]=="none" ? "block" : "none"; }
    event click $(#add) { this.showAdd(); }
    event click $(#refresh) { handler.discover(); this.refresh(); }
    event click $(#sort) { this.reverse=!this.reverse; this.update(); }
    event click $(#grid) { this.list=false; this.update(); }
    event click $(#list) { this.list=true; this.update(); }
    event click $(#addresses) { this.showAddresses=!this.showAddresses; this.update(); }
    event click $(#sciter-about) { handler.open_url("https://sciter.com"); }
    event click $(#help) { handler.open_url("https://github.com/zibo-chen/SubnetDesk"); }
    event click $(#install) { handler.goto_install(); }
    event click $(#activate) { handler.set_option("stop-service",""); this.refresh(); }
    event click $(#identities) { this.showIdentities(); }
    event click $(#rename) { this.openDialog("Name",<div>{field("name","Name",this.info.device_name || "")}</div>,function(values) { return handler.set_device_name(values.name || ""); }); }
    event change $(#dark-theme) (_,button) { handler.set_local_option("theme",button.value ? "dark" : "light"); updateLanTheme(); }
    event change $(#language) (_,select) { handler.set_option("lang",select.value); this.refresh(); }
    event change $(.permission-option) (_,button) { handler.set_option(button.attributes["data-option"],button.value ? "Y" : "N"); }
    event click $(#close-dialog, #cancel-dialog) { this.dialog=null; this.update(); }
    event keydown(evt) {
        if(!this.dialog) return;
        if(evt.keyCode==Event.VK_ESCAPE) { this.dialog=null; this.update(); return true; }
        if(isEnterKey(evt) && evt.target.tag=="input") { this.$(#save-dialog).sendEvent("click"); return true; }
        var first=this.$(.lan-dialog input) || this.$(#close-dialog), last=this.$(#save-dialog);
        if(evt.keyCode==Event.VK_TAB && view.focus==last && !evt.shiftKey) { view.focus=first; return true; }
        if(evt.keyCode==Event.VK_TAB && view.focus==first && evt.shiftKey) { view.focus=last; return true; }
    }
    event click $(#save-dialog) {
        var values={};
        for(var input in this.$$(.lan-dialog input[name], .lan-dialog button[name])) values[input.attributes["name"]]=input.value;
        var error=this.dialog.save(values);
        for(var input in this.$$(.lan-dialog input[type=password])) input.value="";
        if(error) { this.$(#dialog-error).text=error; return; }
        this.dialog=null; this.refresh();
    }
    event click $(button[data-identity]) (_,button) {
        var id=button.attributes["data-identity"], action=button.attributes["data-action"];
        if(action=="edit") {
            var identities=readJson(handler.lan_identity_action(JSON.stringify({action:"list"}))).identities || [];
            for(var identity in identities) if(identity.id==id) {
                this.openDialog("LAN identities",<div>{field("name","Name",identity.name)}{field("username","Username",identity.username)}{field("password","Password","",true)}<button|checkbox name="make_default" {identity.is_default ? {checked:true} : {}}>{translate("Set as default")}</button></div>,function(values) { values.action="update"; values.id=id; var result=readJson(handler.lan_identity_action(JSON.stringify(values))); values.password=""; return result.error || ""; });
                return;
            }
        }
        var result=readJson(handler.lan_identity_action(JSON.stringify({action:action,id:id})));
        if(result.error) this.$(#dialog-error).text=result.error; else this.showIdentities();
    }
    event click $(button[data-id]) (_,button) {
        var id=button.attributes["data-id"], action=button.attributes["data-action"];
        if(action=="connect") this.connect(id);
        else if(action=="favorite") {
            var favorites=this.favorites.filter(function(value) { return value!=id; });
            if(favorites.length==this.favorites.length) favorites.push(id);
            handler.store_fav(favorites); this.refresh();
        } else if(action=="more") {
            var me=this;
            this.openDialog("Connect",<div .peer-menu><p>{id}</p><button .primary data-id={id} data-action="files">{lanIcon("folder")}{translate("File Transfer")}</button><button .text-button data-id={id} data-action="alias">{translate("Rename")}</button><button .text-button data-id={id} data-action="forget">{translate("Forget password")}</button><button .text-button data-id={id} data-action="remove">{translate("Remove")}</button></div>,function(values) { me.connect(id); return ""; });
        } else if(action=="files") { this.dialog=null; this.connect(id,"--file-transfer"); this.update(); }
        else if(action=="remove") { handler.remove_peer(id); this.dialog=null; this.refresh(); }
        else if(action=="forget") { handler.forget_password(id); this.dialog=null; this.refresh(); }
        else if(action=="alias") this.openDialog("Rename",<div>{field("alias","Name",handler.get_peer_option(id,"alias"))}</div>,function(values) { handler.set_peer_option(id,"alias",values.alias || ""); return ""; });
    }
}
function updateLanTheme() { self.attributes["class"]=handler.get_local_option("theme")=="dark" ? "darktheme" : ""; }
function showSettings() { app.page="settings"; app.refresh(); }
function showAbout() { app.page="settings"; app.refresh(); }
function self.closing() { var (x,y,w,h)=view.box(#rectw,#border,#screen); handler.closing(x,y,w,h); return true; }
function self.ready() {
    centerize(scaleIt(1060),scaleIt(760)); updateLanTheme(); app.refresh(); handler.discover();
    self.timer(5s,function() { if(!app.dialog && !$(#msgbox .session-dialog)) app.refresh(); return true; });
}
$(body).content(<div style="size:*"><App/><div #msgbox/></div>);
