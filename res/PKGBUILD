pkgname=subnetdesk
pkgver=1.3.0
pkgrel=0
epoch=
pkgdesc=""
arch=('x86_64')
url=""
license=('AGPL-3.0')
groups=()
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'pam' 'gst-plugins-base' 'gst-plugin-pipewire')
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=pacman_install
changelog=
noextract=()
md5sums=() #generate with 'makepkg -g'

package() {
  if [[ ${FLUTTER} ]]; then
	  mkdir -p "${pkgdir}/usr/share/subnetdesk" && cp -r ${HBB}/flutter/build/linux/x64/release/bundle/* -t "${pkgdir}/usr/share/subnetdesk"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  pushd ${pkgdir} && ln -s /usr/share/subnetdesk/subnetdesk usr/bin/subnetdesk && popd
  install -Dm 644 $HBB/res/subnetdesk.service -t "${pkgdir}/usr/share/subnetdesk/files"
  install -Dm 644 $HBB/res/rustdesk.desktop "${pkgdir}/usr/share/subnetdesk/files/subnetdesk.desktop"
  install -Dm 644 $HBB/res/rustdesk-link.desktop "${pkgdir}/usr/share/subnetdesk/files/subnetdesk-link.desktop"
  install -Dm 644 $HBB/res/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/subnetdesk.png"
  install -Dm 644 $HBB/res/scalable.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/subnetdesk.svg"
}
